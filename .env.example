# Database (Neon / Supabase / Postgres)
DATABASE_URL="postgres://user:password@host:port/db?pgbouncer=true"
DIRECT_URL="postgres://user:password@host:port/db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_strong_secret_with_openssl_rand_base64_32"

# OAuth (Google)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# S3 / File Storage (Optional for this setup, but required for image upload script in admin)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_BUCKET_NAME="usmle-qbank-images"

# Sentry (Optional for error tracking)
NEXT_PUBLIC_SENTRY_DSN=""

# Video hosting: CDN origin that serves /videos/** (R2/Bunny/CloudFront). Leave empty locally.
NEXT_PUBLIC_VIDEO_BASE_URL=

# Demo mode: shows one-click demo logins on /login. NEVER enable on a production deployment with real users.
NEXT_PUBLIC_DEMO_MODE=false
