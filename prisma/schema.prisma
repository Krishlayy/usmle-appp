generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String?
  name                String?
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime        @default(now())
  role                Role            @default(STUDENT)
  securityViolations  Int             @default(0)
  isBlocked           Boolean         @default(false)
  examAttempt         String?
  graduationYear      String?
  medicalSchool       String?
  onboardingCompleted Boolean         @default(false)
  preferredName       String?
  targetDate          String?
  targetExam          String?
  Account             Account[]
  flashcards          Flashcard[]
  highlights          Highlight[]
  purchases           Purchase[]
  editedQBanks        QBank[]         @relation("QBankLastEditedBy")
  issues              QuestionIssue[]
  Session             Session[]
  testSessions        TestSession[]
  progress            UserProgress[]
}

model QBank {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  qbankCode        String     @unique
  questionCounter  Int        @default(0)
  description      String
  specialtyTag     String
  price            Int
  currency         String     @default("USD")
  thumbnailUrl     String?
  totalQuestions   Int        @default(0)
  difficulty       String     @default("Intermediate")
  highYieldScore   Float      @default(8.5)
  boardCoverage    String     @default("USMLE Step 1")
  isActive         Boolean    @default(true)
  stripePriceId    String?
  createdAt        DateTime   @default(now())
  bibliographyTags String[]   @default([])
  lastEditedById   String?
  lastEditedAt     DateTime?
  purchases        Purchase[]
  lastEditedBy     User?      @relation("QBankLastEditedBy", fields: [lastEditedById], references: [id])
  questions        Question[]

  @@index([isActive])
}

model Question {
  id                String          @id @default(cuid())
  qid               String          @unique
  qbankId           String
  questionText      String
  options           Json
  correctAnswer     String
  acceptableAnswers String[]        @default([])
  tags              String[]        @default([])
  explanation       String
  difficulty        String
  subtopic          String?
  imageUrl                 String?
  videoUrl                 String?
  videoPosition            String          @default("TOP")
  videoMnemonicTitle       String?
  videoMnemonicExplanation String?
  youtubeId                String?
  status            String          @default("PUBLISHED")
  createdAt         DateTime        @default(now())
  flashcards        Flashcard[]
  highlights        Highlight[]
  qbank             QBank           @relation(fields: [qbankId], references: [id])
  explanationImages QuestionImage[]
  issues            QuestionIssue[]
  media             QuestionMedia[]
  progress          UserProgress[]

  @@index([qbankId])
  @@index([qbankId, subtopic])
  @@index([status])
}

model QuestionIssue {
  id          String    @id @default(cuid())
  questionId  String
  userId      String
  issueType   String
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([questionId])
}

model QuestionImage {
  id         String   @id @default(cuid())
  questionId String
  url        String
  caption    String?
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionMedia {
  id          String         @id @default(cuid())
  questionId  String
  type        MediaType
  url         String
  caption     String?
  placement   MediaPlacement @default(BOTTOM)
  displaySize String         @default("MEDIUM")
  order       Int            @default(0)
  question    Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, placement, order])
}

model Purchase {
  id              String    @id @default(cuid())
  userId          String
  qbankId         String
  amountPaidCents Int
  stripeSessionId String?   @unique
  status          String    @default("active")
  purchasedAt     DateTime  @default(now())
  expiresAt       DateTime?
  qbank           QBank     @relation(fields: [qbankId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  @@unique([userId, qbankId])
  @@index([userId])
}

model TestSession {
  id          String         @id @default(cuid())
  userId      String
  qbankId     String
  mode        String
  status      String         @default("in_progress")
  durationSec Int?
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  user        User           @relation(fields: [userId], references: [id])
  progress    UserProgress[]

  @@index([userId, qbankId, status])
}

model UserProgress {
  id                      String       @id @default(cuid())
  userId                  String
  questionId              String
  qbankId                 String
  testSessionId           String?
  selectedAnswer          String?
  isCorrect               Boolean?
  flagged                 Boolean      @default(false)
  timeTakenSec            Int?
  notes                   String?
  strikethroughs          String[]     @default([])
  attemptedAt             DateTime     @default(now())
  highlightedExplanation  String?
  highlightedQuestionText String?
  question                Question     @relation(fields: [questionId], references: [id])
  testSession             TestSession? @relation(fields: [testSessionId], references: [id])
  user                    User         @relation(fields: [userId], references: [id])

  @@unique([userId, questionId, testSessionId])
  @@index([userId, qbankId])
  @@index([userId, questionId])
}

model Highlight {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  section     String
  text        String
  startOffset Int
  endOffset   Int
  color       String
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
}

model Flashcard {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  qbankId    String
  front      String
  back       String
  nextReview DateTime @default(now())
  interval   Int      @default(0)
  easeFactor Float    @default(2.5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReview])
  @@index([userId, qbankId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  STUDENT
  ADMIN
  SUPERADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaPlacement {
  TOP
  BOTTOM
}
