// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())
  role          Role       @default(STUDENT)
  purchases     Purchase[]
  progress      UserProgress[]
  testSessions  TestSession[]
}

model QBank {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  qbankCode       String     @unique
  questionCounter Int        @default(0)
  description     String
  specialtyTag    String
  price           Int        // cents (USD)
  currency        String     @default("USD")
  thumbnailUrl    String?
  totalQuestions  Int        @default(0)
  isActive        Boolean    @default(true)
  stripePriceId   String?    // Stripe Price object id
  createdAt       DateTime   @default(now())
  questions       Question[]
  purchases       Purchase[]

  @@index([isActive])
}

model Question {
  id                String    @id @default(cuid())
  qid               String    @unique
  qbankId           String
  qbank             QBank     @relation(fields: [qbankId], references: [id])
  questionText      String
  options           Json      // [{id, text}]
  correctAnswer     String
  acceptableAnswers String[]  @default([])
  tags              String[]  @default([])
  explanation       String
  difficulty        String    // easy | medium | hard
  subtopic          String?   // e.g. "Arrhythmias"
  imageUrl          String?
  videoUrl          String?
  videoPosition     String    @default("TOP") // TOP | BOTTOM
  youtubeId         String?   // Deprecated in favor of videoUrl
  explanationImages QuestionImage[]
  media             QuestionMedia[]
  createdAt         DateTime  @default(now())
  progress          UserProgress[]

  @@index([qbankId])
  @@index([qbankId, subtopic])
}

model QuestionImage {
  id          String    @id @default(cuid())
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  url         String
  caption     String?
  order       Int       @default(0)
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaPlacement {
  TOP
  BOTTOM
}

model QuestionMedia {
  id          String          @id @default(cuid())
  questionId  String
  question    Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  type        MediaType
  url         String
  caption     String?
  placement   MediaPlacement  @default(BOTTOM)
  displaySize String          @default("MEDIUM") // "SMALL" | "MEDIUM" | "LARGE" | "FULL"
  order       Int             @default(0)

  @@index([questionId, placement, order])
}

model Purchase {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  qbankId         String
  qbank           QBank     @relation(fields: [qbankId], references: [id])
  amountPaidCents Int
  stripeSessionId String?   @unique
  status          String    @default("active") // active | refunded
  purchasedAt     DateTime  @default(now())
  expiresAt       DateTime? // null = lifetime (current default)

  @@unique([userId, qbankId])
  @@index([userId])
}

model TestSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  qbankId     String
  mode        String    // "timed" | "tutor"
  status      String    @default("in_progress") // in_progress | completed
  durationSec Int?      // for timed mode
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  progress    UserProgress[]

  @@index([userId, qbankId])
}

model UserProgress {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  questionId      String
  question        Question     @relation(fields: [questionId], references: [id])
  qbankId         String
  testSessionId   String?
  testSession     TestSession? @relation(fields: [testSessionId], references: [id])
  selectedAnswer  String?
  isCorrect       Boolean?
  flagged         Boolean      @default(false)
  timeTakenSec    Int?
  notes           String?
  attemptedAt     DateTime     @default(now())

  @@unique([userId, questionId, testSessionId])
  @@index([userId, qbankId])
}
